# Built application files
*.apk
*.aab
*.ap_

# Exclude generated build outputs, but INCLUDE intentional releases
!/releases/*.apk
!/releases/*.exe

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/resources/
!**/src/test/resources/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/caches/
.idea/libraries/

# OS specific
.DS_Store
Thumbs.db

# Kotlin
.kotlin/

# Agent Directives, Internal Markdown & Planning Files
AGENTS.md
agent.md
issue.txt
markdown/
*.md
!README.md


# Signing keys and credentials must never be committed
*.jks
*.keystore
